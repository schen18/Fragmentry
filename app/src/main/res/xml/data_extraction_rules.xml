<?xml version="1.0" encoding="utf-8"?>
<!-- The memory field never leaves the device through platform backups.
     Preservation is a deliberate act: use the Veil's manual export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="fragmentry.db" />
        <exclude domain="database" path="fragmentry.db-wal" />
        <exclude domain="database" path="fragmentry.db-shm" />
        <exclude domain="database" path="fragmentry.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="fragmentry.db" />
        <exclude domain="database" path="fragmentry.db-wal" />
        <exclude domain="database" path="fragmentry.db-shm" />
        <exclude domain="database" path="fragmentry.db-journal" />
    </device-transfer>
</data-extraction-rules>
