<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy rules for devices older than API 31. Fragmentry's minSdk (33)
     makes data_extraction_rules.xml authoritative, but both stay aligned. -->
<full-backup-content>
    <exclude domain="database" path="fragmentry.db" />
    <exclude domain="database" path="fragmentry.db-wal" />
    <exclude domain="database" path="fragmentry.db-shm" />
    <exclude domain="database" path="fragmentry.db-journal" />
</full-backup-content>
